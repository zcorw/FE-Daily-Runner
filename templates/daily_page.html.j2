{% extends "base.html.j2" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<script>
  document.documentElement.classList.add("js-enabled");
</script>
<style>
  .daily-shell {
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px 72px 64px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 432px;
    gap: 32px;
    align-items: start;
    margin-bottom: 16px;
  }

  .quick-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 32px;
    padding: 14px 24px;
    border: 1px solid rgba(223, 232, 226, 0.78);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
  }

  .quick-nav__label {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
  }

  .quick-nav__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    min-width: 0;
  }

  .quick-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .quick-nav__link:hover,
  .quick-nav__link:focus-visible {
    background: var(--green-soft);
    color: var(--green);
  }

  .hero__eyebrow,
  .tag-row,
  .term-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .pill::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .pill--green { background: var(--green-soft); color: var(--green); }
  .pill--amber { background: var(--amber-soft); color: var(--amber); }
  .pill--red { background: var(--red-soft); color: var(--red); }

  .hero h1 {
    margin: 18px 0 0;
    max-width: 820px;
    font-size: 58px;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .hero__theme {
    margin: 14px 0 0;
    color: var(--green);
    font-size: 30px;
    line-height: 1.25;
    font-weight: 800;
  }

  .hero__summary {
    max-width: 820px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 18px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .hero-stat {
    min-height: 98px;
    border-radius: 8px;
    padding: 18px;
    background: var(--green-soft);
  }

  .hero-stat:nth-child(2) { background: var(--blue-soft); color: var(--blue); }
  .hero-stat:nth-child(3) { background: var(--amber-soft); color: var(--amber); }

  .hero-stat__value {
    display: block;
    color: var(--green);
    font-size: 28px;
    line-height: 1;
    font-weight: 800;
  }

  .hero-stat:nth-child(2) .hero-stat__value { color: var(--blue); }
  .hero-stat:nth-child(3) .hero-stat__value { color: var(--amber); }

  .hero-stat__label {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
  }

  .overview-grid,
  .review-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 432px;
    gap: 24px;
    align-items: start;
    margin-bottom: 32px;
  }

  .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .daily-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 28px;
  }

  .daily-card + .daily-card,
  .full-card {
    margin-bottom: 32px;
  }

  .daily-card h2 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
  }

  .section-subtitle {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .goal-list,
  .review-list {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .goal-list li,
  .review-list li {
    position: relative;
    padding-left: 20px;
  }

  .goal-list li::before,
  .review-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  .practice-mix {
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }

  .practice-mix__row {
    display: grid;
    grid-template-columns: minmax(80px, 1fr) auto;
    gap: 12px;
    align-items: center;
    font-weight: 700;
  }

  .practice-mix__bar {
    height: 10px;
    border-radius: 999px;
    background: var(--green);
  }

  .practice-mix__row:nth-child(2) .practice-mix__bar { background: var(--blue); }
  .practice-mix__row:nth-child(3) .practice-mix__bar { background: var(--amber); }
  .practice-mix__row:nth-child(4) .practice-mix__bar { background: var(--red); }

  .time-card-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .time-card {
    min-height: 112px;
    border-radius: 8px;
    padding: 18px;
    background: var(--green-soft);
  }

  .time-card:nth-child(even) { background: #fbfcfb; }

  .time-card__minutes {
    color: var(--green);
    font-size: 20px;
    font-weight: 800;
  }

  .time-card:nth-child(even) .time-card__minutes { color: var(--blue); }

  .time-card__task {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 800;
  }

  .time-card__detail {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
  }

  .question-list {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .question-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fbfdfc;
    padding: 16px;
  }

  .question-card__summary {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .question-card__number {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }

  .question-card:nth-child(3n) .question-card__number,
  .question-card:nth-child(4n) .question-card__number { background: var(--blue); }
  .question-card:nth-child(5n) .question-card__number { background: var(--amber); }
  .question-card:nth-child(7n) .question-card__number { background: var(--red); }

  .question-card h3 {
    margin: 0;
    font-size: 16px;
    line-height: 1.35;
  }

  .question-meta {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .question-detail {
    margin: 16px 0 0 60px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .choice-list,
  .wrong-choice-list {
    display: grid;
    gap: 8px;
    padding-left: 1.2rem;
  }

  .choice-list {
    padding-left: 0;
    list-style: none;
  }

  .choice-button {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .choice-button:hover,
  .choice-button:focus-visible {
    border-color: var(--blue);
    background: var(--blue-soft);
    outline: none;
  }

  .choice-button.is-selected {
    border-color: var(--blue);
    box-shadow: inset 4px 0 0 var(--blue);
  }

  .choice-button.is-correct {
    border-color: var(--green);
    background: var(--green-soft);
    box-shadow: inset 4px 0 0 var(--green);
  }

  .choice-button.is-incorrect {
    border-color: var(--red);
    background: var(--red-soft);
    box-shadow: inset 4px 0 0 var(--red);
  }

  .answer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 14px 0;
  }

  .answer-toggle {
    min-height: 38px;
    border: 1px solid var(--green);
    border-radius: 8px;
    padding: 8px 12px;
    background: var(--green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
  }

  .answer-toggle:hover,
  .answer-toggle:focus-visible {
    background: #0f6f47;
    outline: none;
  }

  .choice-status {
    min-height: 1.4em;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }

  .js-enabled .answer-panel {
    display: none;
  }

  .js-enabled .answer-panel.is-open {
    display: block;
  }

  .review-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 18px;
    font-size: 13px;
  }

  .terms-table-wrap {
    margin-top: 18px;
    overflow-x: auto;
  }

  .terms-table {
    width: 100%;
    min-width: 1040px;
    border-collapse: separate;
    border-spacing: 0 8px;
    font-size: 13px;
  }

  .terms-table th,
  .terms-table td {
    padding: 14px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #fbfdfc;
  }

  .terms-table th {
    background: var(--green-soft);
    color: var(--green);
    font-weight: 800;
  }

  .terms-table td:first-child,
  .terms-table th:first-child {
    border-left: 1px solid var(--line);
    border-radius: 8px 0 0 8px;
    font-weight: 800;
    width: 18%;
  }

  .terms-table td:last-child,
  .terms-table th:last-child {
    border-right: 1px solid var(--line);
    border-radius: 0 8px 8px 0;
    width: 18%;
  }

  .terms-table td:nth-child(2) { width: 34%; }
  .terms-table td:nth-child(3) { width: 30%; }

  .term-card-list {
    display: none;
  }

  .term-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 12px;
  }

  .term-card__header {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .term-card__number {
    display: grid;
    place-items: center;
    width: 30px;
    height: 26px;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green);
    font-size: 10px;
    font-weight: 800;
  }

  .term-card__term {
    font-size: 16px;
    line-height: 1.35;
    font-weight: 800;
  }

  .term-card__field {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 8px;
    margin-top: 10px;
  }

  .term-card__label {
    font-size: 10px;
    line-height: 1.6;
    font-weight: 800;
  }

  .term-card__field[data-term-field="meaning"] .term-card__label { color: var(--green); }
  .term-card__field[data-term-field="exam-note"] .term-card__label { color: var(--amber); }
  .term-card__field[data-term-field="trap"] .term-card__label { color: var(--red); }

  .term-card__body {
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
  }

  .review-table th,
  .review-table td {
    border: 1px solid var(--line);
    padding: 10px;
    text-align: left;
  }

  .review-table th {
    background: #f2f6f4;
  }

  .footer-note {
    color: var(--muted);
    font-size: 13px;
  }

  [id] {
    scroll-margin-top: 86px;
  }

  @media (max-width: 960px) {
    .daily-shell { padding: 32px 18px 48px; }
    .hero,
    .overview-grid,
    .review-grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 40px; }
    .hero-stats,
    .time-card-grid { grid-template-columns: 1fr; }
    .question-detail { margin-left: 0; }
  }

  @media (max-width: 640px) {
    .quick-nav {
      gap: 10px;
      margin-right: -18px;
      margin-left: -18px;
      margin-bottom: 24px;
      padding: 8px 18px;
      border-right: 0;
      border-left: 0;
      border-radius: 0;
    }

    .quick-nav__links {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .quick-nav__links::-webkit-scrollbar {
      display: none;
    }

    .quick-nav__link {
      min-height: 28px;
      padding: 5px 9px;
    }

    .terms-table-wrap { display: none; }
    .term-card-list { display: grid; gap: 14px; margin-top: 18px; }
  }
</style>

<article class="daily-shell" data-page-type="daily" data-date="{{ date }}" data-page-url="{{ page_url }}" data-main-theme="{{ main_theme }}">
  <section class="hero" aria-labelledby="daily-title">
    <div>
      <div class="hero__eyebrow">
        <span class="pill pill--green">{{ date }}</span>
        <span class="pill">科目A演習</span>
        <span class="pill pill--amber">{{ questions|length }}問</span>
      </div>
      <h1 id="daily-title">{{ title }}</h1>
      <p class="hero__theme">{{ main_theme }}</p>
      <p class="hero__summary">{{ plan_reference.reading_assignment }} を読み、{{ main_theme }}を題目で判断できる状態にする。</p>
    </div>
    <div class="hero-stats" aria-label="学習時間の概要">
      <div class="hero-stat"><span class="hero-stat__value">{{ time_table[0].minutes if time_table|length > 0 else 10 }}m</span><span class="hero-stat__label">読解</span></div>
      <div class="hero-stat"><span class="hero-stat__value">{{ time_table[2].minutes if time_table|length > 2 else 25 }}m</span><span class="hero-stat__label">演習</span></div>
      <div class="hero-stat"><span class="hero-stat__value">{{ (time_table[3].minutes if time_table|length > 3 else 10) + (time_table[4].minutes if time_table|length > 4 else 5) }}m</span><span class="hero-stat__label">復習</span></div>
    </div>
  </section>

  <nav class="quick-nav" aria-label="ページ内ナビゲーション">
    <span class="quick-nav__label">ページ内</span>
    <div class="quick-nav__links">
      <a class="quick-nav__link" href="#daily-goals">目標</a>
      <a class="quick-nav__link" href="#practice-mix">演習</a>
      <a class="quick-nav__link" href="#time-table">時間</a>
      <a class="quick-nav__link" href="#reading-assignment">読解</a>
      <a class="quick-nav__link" href="#study-checklist">チェック</a>
      <a class="quick-nav__link" href="#terms">重要用語</a>
      <a class="quick-nav__link" href="#daily-explanation">講解</a>
      <a class="quick-nav__link" href="#questions">問題</a>
      <a class="quick-nav__link" href="#knowledge-points">メモ</a>
      <a class="quick-nav__link" href="#review">復習</a>
      <a class="quick-nav__link" href="#tomorrow">明日</a>
    </div>
  </nav>

  <div class="overview-grid">
    <section id="daily-goals" class="daily-card" data-section="daily-goals">
      <h2>今日の目標</h2>
      <p class="section-subtitle">主題と到達目標</p>
      <ul class="goal-list">
        <li>主題: {{ main_theme }}</li>
        <li>学習計画の {{ date }} 行に基づいて進める。</li>
        <li>読解範囲: <code>{{ plan_reference.reading_assignment }}</code></li>
        <li>演習配分: <code>{{ plan_reference.practice_focus }}</code></li>
        {% for goal in goals %}
        <li>{{ goal }}</li>
        {% endfor %}
        <li>学習時間の目安は約60分。</li>
      </ul>
    </section>

    <section id="practice-mix" class="daily-card" data-section="practice-mix">
      <h2>演習構成</h2>
      <p class="section-subtitle">題庫検索で使う演習バケット</p>
      <div class="practice-mix">
        {% for part in plan_reference.practice_focus.split(",") %}
        {% set item = part.strip() %}
        {% set pieces = item.rsplit(" ", 1) %}
        {% set count = pieces[1] if pieces|length > 1 and pieces[1].isdigit() else "" %}
        {% set label = pieces[0] if count else item %}
        <div class="practice-mix__row">
          <div class="practice-mix__bar" style="width: {{ 46 * (count|int if count else 1) }}px"></div>
          <span>{{ label }}{% if count %} / {{ count }}問{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      <p class="section-subtitle">利用可能な場合は正規化済みトピックタグで検索する。</p>
    </section>
  </div>

  <section id="time-table" class="daily-card full-card" data-section="time-table">
    <h2>時間配分</h2>
    <p class="section-subtitle">60分で進める実行計画</p>
    <div class="time-card-grid">
      {% for item in time_table %}
      <div class="time-card">
        <div class="time-card__minutes">{{ item.minutes }}分</div>
        <div class="time-card__task">{% if item.task is defined %}{{ item.task.split(":")[0] }}{% else %}学習タスク{% endif %}</div>
        <div class="time-card__detail">{% if item.task is defined %}{{ item.task }}{% else %}学習タスク{% endif %}</div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section id="reading-assignment" class="daily-card full-card" data-section="reading-assignment">
    <h2>書籍の読解範囲</h2>
    <p class="section-subtitle">{{ date }} の学習計画から取得した範囲。章全体には広げない。</p>
    <p><strong>{{ main_theme }}</strong> / 読解範囲 / <code>{{ plan_reference.reading_assignment }}</code></p>
  </section>

  <section id="study-checklist" class="daily-card full-card" data-section="study-checklist">
    <h2>学習チェックリスト</h2>
    <ul class="goal-list">
      <li><input type="checkbox" disabled> 指定された読解範囲を読み、重要な手順に印を付ける。</li>
      <li><input type="checkbox" disabled> 科目Aの10問をすべて解く。</li>
      <li><input type="checkbox" disabled> 計算問題では式、桁、判断手順を書き出す。</li>
      <li><input type="checkbox" disabled> 間違えた問題を復習表に記録する。</li>
      <li><input type="checkbox" disabled> 本日の演習配分を確認する: {{ plan_reference.practice_focus }}</li>
    </ul>
  </section>

  <section id="terms" class="daily-card full-card" data-section="terms">
    <h2>重要用語</h2>
    <p class="section-subtitle">用語、意味、試験での注意点、落とし穴を整理する。</p>
    <div class="term-pills">
      {% for item in terms %}
      <span class="pill">{{ item.term }}</span>
      {% endfor %}
    </div>
    <div class="terms-table-wrap">
      <table class="terms-table">
        <thead>
          <tr>
            <th>用語</th>
            <th>意味</th>
            <th>試験での注意点</th>
            <th>落とし穴</th>
          </tr>
        </thead>
        <tbody>
          {% for item in terms %}
          <tr>
            <td>{{ item.term }}</td>
            <td>{{ item.meaning }}</td>
            <td>{{ item.exam_note }}</td>
            <td>{% if item.trap %}{{ item.trap }}{% else %}-{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="term-card-list" aria-label="重要用語のモバイル表示">
      {% for item in terms %}
      <article class="term-card">
        <div class="term-card__header">
          <span class="term-card__number">{{ "%02d"|format(loop.index) }}</span>
          <div class="term-card__term">{{ item.term }}</div>
        </div>
        <div class="term-card__field" data-term-field="meaning">
          <div class="term-card__label">意味</div>
          <p class="term-card__body">{{ item.meaning }}</p>
        </div>
        <div class="term-card__field" data-term-field="exam-note">
          <div class="term-card__label">注意</div>
          <p class="term-card__body">{{ item.exam_note }}</p>
        </div>
        <div class="term-card__field" data-term-field="trap">
          <div class="term-card__label">罠</div>
          <p class="term-card__body">{% if item.trap %}{{ item.trap }}{% else %}-{% endif %}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="daily-explanation" class="daily-card full-card" data-section="daily-explanation">
    <h2>今日知识点讲解</h2>
    <p class="section-subtitle">読解範囲、弱点、選定問題の知識点をつなげて整理する。</p>
    {% for point in daily_explanation %}
    <p><strong>{{ point.title }}.</strong> {{ point.body }}</p>
    {% endfor %}
  </section>

  <section id="questions" class="daily-card full-card" data-section="questions">
    <h2>科目A 練習問題</h2>
    <p class="section-subtitle">本日のテーマに合わせて Runtime 題庫から選んだ {{ questions|length }} 問</p>
    <div class="question-list">
      {% for question in questions %}
      {% set question_index = loop.index %}
      <article class="question-card" data-question="{{ loop.index }}" data-answer="{{ question.answer }}">
        <div class="question-card__summary">
          <div class="question-card__number">{{ "%02d"|format(loop.index) }}</div>
          <div>
            <h3>問題 {{ loop.index }}</h3>
            <p class="question-meta">
              {% if question.knowledge_point %}{{ question.knowledge_point }}{% else %}{{ main_theme }}{% endif %}
              · {% if question.planned_bucket is defined %}{{ question.planned_bucket }}{% else %}{{ main_theme }}{% endif %}
              · <a href="{{ question.source_url }}">{{ question.source_url }}</a>
            </p>
          </div>
        </div>

        <div class="question-detail">
          <ul class="question-meta">
            <li>出典種別: <code>{% if question.source_type is defined %}{{ question.source_type }}{% else %}DB index / cached question_details{% endif %}</code></li>
            <li>出典試験: {% if question.source_exam is defined %}{{ question.source_exam }}{% else %}Runtime 題庫{% endif %}</li>
            <li>シラバス領域: {% if question.syllabus_area is defined %}{{ question.syllabus_area }}{% else %}科目A{% endif %}</li>
          </ul>

          <div data-question-field="question-body">
            <p><strong>問題文</strong></p>
            <p>{{ question.question_text }}</p>
            {% for image in question.images %}
            <p><img src="{{ image.publicPath }}" alt="{% if image.alt is defined %}{{ image.alt }}{% else %}問題 {{ question_index }} の問題画像{% endif %}"></p>
            {% endfor %}
          </div>

          <p><strong>選択肢</strong></p>
          <ul class="choice-list">
            {% for key, value in question.choices.items() %}
            <li>
              <button
                type="button"
                class="choice-button"
                data-choice-option
                data-choice-label="{{ key }}"
                aria-pressed="false"
              >{{ key }} {{ value }}</button>
            </li>
            {% endfor %}
          </ul>

          <div class="answer-actions">
            <button type="button" class="answer-toggle" data-answer-toggle aria-expanded="false">解答を表示</button>
            <p class="choice-status" data-choice-status aria-live="polite"></p>
          </div>

          <div class="answer-panel" data-question-field="answer-explanation">
            <p><strong>正答</strong>: {{ question.answer }}</p>
            <p><strong>解説</strong></p>
            <p>{{ question.explanation }}</p>
            {% if question.explanation_images is defined %}
            {% for image in question.explanation_images %}
            <p><img src="{{ image.publicPath }}" alt="{% if image.alt is defined %}{{ image.alt }}{% else %}問題 {{ question_index }} の解説画像{% endif %}"></p>
            {% endfor %}
            {% endif %}
            <p><strong>関連用語</strong>: {% if question.knowledge_point %}{{ question.knowledge_point }}, {% endif %}{{ main_theme }}</p>
            <p><strong>他の選択肢が誤りである理由</strong></p>
            <ul class="wrong-choice-list">
              {% for key, value in question.choices.items() %}
              {% if key != question.answer %}
              <li>{{ key }} {{ question.distractor_explanations[key] }}</li>
              {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="knowledge-points" class="daily-card full-card" data-section="knowledge-points">
    <h2>知識メモ</h2>
    <p class="section-subtitle">解答確認前に押さえる短い復習</p>
    {% for point in knowledge_points %}
    <p><strong>{{ point.title }}.</strong> {{ point.body }}</p>
    {% endfor %}
  </section>

  <div class="review-grid">
    <section id="review" class="daily-card" data-section="review">
      <h2>復習欄</h2>
      <p class="section-subtitle">誤答理由の候補:</p>
      <ul class="review-list">
        <li>用語を知らなかった</li>
        <li>概念が曖昧だった</li>
        <li>公式を覚えていなかった</li>
        <li>問題文を読み違えた</li>
        <li>選択肢を混同した</li>
        <li>非技術分野の知識が不足していた</li>
        <li>ケアレスミス</li>
      </ul>
      <table class="review-table">
        <thead>
          <tr><th>問題</th><th>正解?</th><th>誤答理由</th><th>復習する知識</th></tr>
        </thead>
        <tbody>
          {% for item in review_table_template %}
          <tr><td>問題 {{ item.question_no }}</td><td></td><td></td><td></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section id="tomorrow" class="daily-card" data-section="tomorrow">
      <h2>明日の提案</h2>
      <p>{% if tomorrow_suggestion.theme is defined %}{{ tomorrow_suggestion.theme }}{% else %}次の予定テーマを続けて復習する。{% endif %}</p>
    </section>
  </div>

  <p class="footer-note">ローカル FE Daily ページから生成 / {{ page_url }}</p>
</article>
<script>
  (function () {
    function openAnswer(card) {
      var panel = card.querySelector('[data-question-field="answer-explanation"]');
      var toggle = card.querySelector("[data-answer-toggle]");
      if (!panel || !toggle) return;
      panel.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.textContent = "解答を表示中";
    }

    function updateChoiceState(card, selectedButton) {
      var answer = card.getAttribute("data-answer");
      var status = card.querySelector("[data-choice-status]");
      var buttons = card.querySelectorAll("[data-choice-option]");

      buttons.forEach(function (button) {
        var label = button.getAttribute("data-choice-label");
        button.classList.remove("is-selected", "is-correct", "is-incorrect");
        button.setAttribute("aria-pressed", "false");
        if (label === answer) {
          button.classList.add("is-correct");
        }
      });

      selectedButton.classList.add("is-selected");
      selectedButton.setAttribute("aria-pressed", "true");
      if (selectedButton.getAttribute("data-choice-label") !== answer) {
        selectedButton.classList.add("is-incorrect");
      }
      if (status) {
        status.textContent = selectedButton.getAttribute("data-choice-label") === answer
          ? "正解です。解説を確認しましょう。"
          : "選択した答えと正答を比べましょう。";
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll("[data-question]").forEach(function (card) {
        var toggle = card.querySelector("[data-answer-toggle]");
        var panel = card.querySelector('[data-question-field="answer-explanation"]');
        if (toggle && panel) {
          var panelId = "answer-panel-" + card.getAttribute("data-question");
          panel.id = panelId;
          toggle.setAttribute("aria-controls", panelId);
          toggle.addEventListener("click", function () {
            openAnswer(card);
          });
        }

        card.querySelectorAll("[data-choice-option]").forEach(function (button) {
          button.addEventListener("click", function () {
            updateChoiceState(card, button);
            openAnswer(card);
          });
        });
      });
    });
  }());
</script>
{% endblock %}
